# Zephyx Mail — Staging environment template
# Copy to a deployment secret store or an untracked .env.staging file.
# Never commit populated secrets. Use a separate database, Redis namespace,
# OAuth client, SMTP account, object-storage bucket, and webhook secret from Production.

# -----------------------------------------------------------------------------
# Environment identity and public URLs
# -----------------------------------------------------------------------------
STAGING_ENVIRONMENT=staging
STAGING_DATA_NAMESPACE=zephyx-staging
STAGING_APP_DOMAIN=staging.example.invalid
STAGING_APP_BASE_URL=https://staging.example.invalid
STAGING_WEB_URL=https://staging.example.invalid
STAGING_ALLOWED_ORIGINS=https://staging.example.invalid
STAGING_API_PORT=3500
STAGING_WEB_PORT=3300
STAGING_CADDY_HTTP_PORT=80
STAGING_CADDY_HTTPS_PORT=443
STAGING_ACME_EMAIL=

# Local-only mode may use http://localhost:3300 and no ACME email.
# For shared staging, use HTTPS URLs and a real DNS record, but never a production domain.
STAGING_TLS_MODE=external
STAGING_TRUST_PROXY=1
STAGING_REQUEST_BODY_LIMIT_BYTES=10485760
STAGING_ENABLE_SECURITY_HEADERS=true
STAGING_ENABLE_RATE_LIMITING=true
STAGING_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL — staging-only instance and database
# -----------------------------------------------------------------------------
STAGING_PGHOST=staging-postgres
STAGING_PGPORT=5432
STAGING_PGUSER=zephyx_staging
STAGING_PGPASSWORD=
STAGING_PGDATABASE=zephyx_staging
STAGING_DATABASE_URL=
STAGING_PGSSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis/BullMQ/SSE — staging-only instance and namespace
# -----------------------------------------------------------------------------
STAGING_REDIS_HOST=staging-redis
STAGING_REDIS_PORT=6379
STAGING_REDIS_PASSWORD=
STAGING_REDIS_URL=
STAGING_REDIS_TLS=false
STAGING_QUEUE_PREFIX=zephyx-staging
STAGING_RATE_LIMIT_REDIS_PREFIX=zephyx-staging:ratelimit
STAGING_SSE_ENABLED=true
STAGING_SSE_MAX_CONNECTIONS_PER_USER=3
STAGING_SSE_REPLAY_LIMIT=50
STAGING_SSE_HEARTBEAT_MS=25000

# -----------------------------------------------------------------------------
# Authentication, sessions, 2FA, and cookies
# -----------------------------------------------------------------------------
STAGING_JWT_ACCESS_SECRET=
STAGING_JWT_REFRESH_SECRET=
STAGING_SESSION_IP_HASH_SECRET=
STAGING_TWO_FACTOR_ENCRYPTION_KEY=
STAGING_TWO_FACTOR_ISSUER=Zephyx Mail Staging
STAGING_JWT_ACCESS_EXPIRY=15m
STAGING_COOKIE_SECURE=true
STAGING_COOKIE_SAME_SITE=lax
STAGING_ENABLE_2FA=true

# -----------------------------------------------------------------------------
# SMTP test transport — use Mailpit/MailHog or a dedicated staging relay only
# -----------------------------------------------------------------------------
STAGING_SMTP_HOST=staging-smtp
STAGING_SMTP_PORT=1025
STAGING_SMTP_SECURE=false
STAGING_SMTP_USER=
STAGING_SMTP_PASS=
STAGING_SMTP_FROM=Zephyx Mail Staging <no-reply@staging.example.invalid>
STAGING_SMTP_CONNECTION_TIMEOUT_MS=10000
STAGING_SMTP_GREETING_TIMEOUT_MS=10000
STAGING_SMTP_SOCKET_TIMEOUT_MS=15000
STAGING_TEST_SMTP_UI_URL=http://localhost:8025

# -----------------------------------------------------------------------------
# Gmail OAuth — disabled unless a separate staging OAuth client is supplied
# -----------------------------------------------------------------------------
STAGING_ENABLE_GMAIL=false
STAGING_GOOGLE_CLIENT_ID=
STAGING_GOOGLE_CLIENT_SECRET=
STAGING_GOOGLE_REDIRECT_URI=https://staging.example.invalid/api/auth/google/callback
STAGING_GMAIL_TOKEN_ENCRYPTION_KEY=
STAGING_GMAIL_PUBSUB_OIDC_AUDIENCE=
STAGING_GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
STAGING_GMAIL_PROVIDER_STATUS=not_configured

# -----------------------------------------------------------------------------
# ClamAV attachment scanning — enabled for the isolated staging ClamAV service
# -----------------------------------------------------------------------------
STAGING_ATTACHMENT_SCANNING_ENABLED=true
STAGING_CLAMAV_HOST=staging-clamav
STAGING_CLAMAV_PORT=3310
STAGING_ATTACHMENT_MAX_COUNT=10
STAGING_ATTACHMENT_MAX_SIZE_BYTES=26214400
STAGING_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=52428800
STAGING_CLAMAV_STATUS=configured

# -----------------------------------------------------------------------------
# Push notifications — Fake adapter by default; no real credentials in Git/CI
# -----------------------------------------------------------------------------
STAGING_ENABLE_NOTIFICATIONS=true
STAGING_NOTIFICATION_PROVIDER=fake
STAGING_NOTIFICATION_TOKEN_ENCRYPTION_KEY=
STAGING_FCM_ENABLED=false
STAGING_FCM_PROJECT_ID=
STAGING_FCM_ACCESS_TOKEN=
STAGING_FCM_STATUS=not_configured
STAGING_WEB_PUSH_ENABLED=false
STAGING_WEB_PUSH_VAPID_PUBLIC_KEY=
STAGING_WEB_PUSH_VAPID_PRIVATE_KEY=
STAGING_WEB_PUSH_STATUS=not_configured

# -----------------------------------------------------------------------------
# Billing — Fake provider only until a staging webhook secret is provisioned
# -----------------------------------------------------------------------------
STAGING_ENABLE_BILLING=false
STAGING_BILLING_PROVIDER=fake
STAGING_BILLING_DEFAULT_PLAN=free
STAGING_BILLING_TRIAL_DAYS=14
STAGING_BILLING_WEBHOOK_SECRET=
STAGING_BILLING_WEBHOOK_BASE_URL=https://staging.example.invalid/api/billing/webhooks
STAGING_BILLING_STATUS=not_configured

# -----------------------------------------------------------------------------
# Background jobs and process lifecycle
# -----------------------------------------------------------------------------
STAGING_WORKER_CONCURRENCY=3
STAGING_QUEUE_MAX_ATTEMPTS=3
STAGING_QUEUE_BACKOFF_MS=1000
STAGING_JOB_TIMEOUT_MS=120000
STAGING_WORKER_SHUTDOWN_TIMEOUT_MS=30000
STAGING_WORKER_HARD_SHUTDOWN_TIMEOUT_MS=60000
STAGING_WORKER_LOCK_DURATION_MS=30000
STAGING_SCHEDULER_ENABLED=true
STAGING_EMAIL_SCHEDULER_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# S3-compatible Object Storage — MinIO staging bucket only
# -----------------------------------------------------------------------------
# These values are placeholders. Inject real staging-only credentials outside Git.
S3_ENDPOINT=http://staging-object-storage:9000
S3_REGION=us-east-1
S3_BUCKET=zephyx-mail-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Legacy Replit App Storage identifiers are unused when S3_* is complete.
STAGING_APP_STORAGE_BUCKET_ID=
STAGING_REPLIT_OBJECT_STORAGE_BUCKET_ID=
STAGING_GEMINI_API_KEY=
STAGING_GEMINI_MODEL=gemini-3-flash-preview

# -----------------------------------------------------------------------------
# Backups and restore verification — never point at Production
# -----------------------------------------------------------------------------
STAGING_BACKUP_DIR=/var/lib/zephyx-staging/backups
STAGING_BACKUP_RETENTION_DAYS=7
STAGING_BACKUP_SCHEDULE=0 3 * * *
STAGING_RESTORE_VERIFY_DATABASE_URL=
STAGING_ALLOW_DATABASE_RESTORE=
STAGING_BACKUP_STATUS=not_configured

# -----------------------------------------------------------------------------
# Safe test data
# -----------------------------------------------------------------------------
STAGING_TEST_DATA_ENABLED=true
STAGING_TEST_DATA_SEED=v7-staging-only
STAGING_TEST_USER_PREFIX=staging-test
# Test users/passwords are generated at runtime by the smoke harness and are never stored here.
