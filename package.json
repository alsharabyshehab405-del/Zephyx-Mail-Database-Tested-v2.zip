{
  "name": "workspace",
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "test:unit": "pnpm --dir artifacts/api-server run test:jest",
    "test:integration": "pnpm --dir artifacts/api-server run test:run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "v5:todos": "node scripts/validate-v5-todos.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "staging:validate": "node scripts/validate-staging-env.mjs .env.staging.example",
    "staging:seed": "node scripts/staging-seed.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "load:test": "node scripts/load-test.mjs",
    "load:scalability": "node scripts/scalability-load-test.mjs",
    "test:queue": "pnpm --dir artifacts/api-server run test:queue",
    "test:worker": "pnpm --dir artifacts/api-server run test:worker",
    "db:validate": "pnpm --dir artifacts/api-server run prisma:validate",
    "db:generate": "pnpm --dir artifacts/api-server run prisma:generate",
    "db:migrate:deploy": "pnpm --dir artifacts/api-server run prisma:migrate:deploy",
    "verify": "pnpm run typecheck && pnpm run test:unit && pnpm run build"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.52.0",
    "prettier": "^3.9.5",
    "tsx": "4.23.0",
    "typescript": "~5.9.3"
  }
}
