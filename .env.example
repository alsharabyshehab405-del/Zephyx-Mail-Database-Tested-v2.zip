# Zephyx Mail environment variables
# Copy this file to .env and provide your own values.
# Never commit .env or any real credentials.

# Application runtime
NODE_ENV=production
PORT=3000
APP_NAME=Zephyx Mail
APP_BASE_URL=http://localhost:3000
NOVAMAIL_WEB_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
BASE_PATH=/
LOG_LEVEL=info

# PostgreSQL
PGUSER=zephyx
PGPASSWORD=
PGDATABASE=zephyx
DATABASE_URL=

# Authentication and session security
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
SESSION_IP_HASH_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Zephyx Mail

# SMTP and transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gmail OAuth and synchronization
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_INITIAL_SYNC_MAX=100

# Optional Gmail Pub/Sub push synchronization
GMAIL_PUBSUB_OIDC_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Attachment/object storage
APP_STORAGE_BUCKET_ID=
REPLIT_OBJECT_STORAGE_BUCKET_ID=

# AI assistant (optional; AI endpoints degrade gracefully when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Send scheduling
UNDO_SEND_DELAY_SECONDS=8
EMAIL_SCHEDULER_INTERVAL_MS=1000

# Rate limits
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=20
EMAIL_ACTION_RATE_LIMIT_WINDOW_MS=600000
EMAIL_ACTION_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=600000
PASSWORD_RESET_RATE_LIMIT_MAX=10

# Replit-provided deployment metadata (normally injected by Replit)
REPL_ID=
REPLIT_DOMAINS=
REPLIT_DEPLOYMENT=

# Production security controls; keep credentials empty in this template.
CLAMAV_HOST=
CLAMAV_PORT=3310
ATTACHMENT_MAX_COUNT=10
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_MAX_TOTAL_SIZE_BYTES=52428800
# Send POST /api/emails with Idempotency-Key to prevent duplicate sends.
