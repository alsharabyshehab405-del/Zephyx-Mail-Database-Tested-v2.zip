modules = ["nodejs-24", "postgresql-16"]

[deployment]
build = "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/novamail-web run build"
run = "pnpm --filter @workspace/api-server run start"
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/novamail-web: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/novamail-web"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/novamail-web run dev"
cwd = "./artifacts/novamail-web"
waitForPort = 18816
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "18816"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["psmisc", "python310", "rsync"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 18816
externalPort = 3002

[[workflows.workflow]]
name = "Project"
author = "user"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/novamail-web run dev"
cwd = "./artifacts/novamail-web"
waitForPort = 5173
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "5173"
BASE_PATH = "/"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"

[workflows.workflow.tasks.env]
PORT = "3000"
